{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2023"],
    "noEmit": true
  },
  "include": ["spike/**/*.ts", "src/**/*.ts"]
}
